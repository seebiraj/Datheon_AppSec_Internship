 import { Router, Request, Response } from 'express';
 import { db } from '../../db/store';
+import { requireSessionAuth } from '../../middleware/sessionAuth';
+import { enforceObjectLevelAuthorization } from '../../middleware/authGuard';
 
 const router = Router();
 
-/**
