+/**
+ * HARDENED IMPLEMENTATION (Post-Remediation):
+ * Zero-Trust Route Defense & Multi-Tenant Scoped Lookups
+ * Defenses:
+ * 1. requireSessionAuth: Rejects unauthenticated callers with HTTP 401
+ * 2. enforceObjectLevelAuthorization: Checks subject vs requested resource
+ * 3. findByIdWithOwnership: Scoped DB query filters by (resourceId AND sessionUserId)
+ */
+router.get(
+  '/candidates/:id',
+  requireSessionAuth,
+  enforceObjectLevelAuthorization,
+  (req: Request, res: Response) => {
+    const { id } = req.params;
+    const sessionUser = req.user!;
+
+    // Remediated: DB query filters by BOTH resource ID and session subject context
+    const candidate = db.findByIdWithOwnership(id, sessionUser.userId, sessionUser.role);
+
+    if (!candidate) {
+      // Return 404/403 gracefully without leaking schema or stack traces
+      return res.status(404).json({
+        success: false,
+        error: 'RESOURCE_NOT_FOUND',
+        message: 'The requested resource was not found or you are not authorized to view it.'
+      });
+    }
+
+    return res.status(200).json({
+      success: true,
+      message: 'Authorized access granted.',
+      data: candidate
+    });
+  }
+);
+
+export default router;
